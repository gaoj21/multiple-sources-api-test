# 复制为 .env 并填入。没填的 API 只做"无 key 探测", 不会报错。

# --- 免费, 邮箱注册即得: https://api.data.gov/signup  (GovInfo / api.ftc.gov 共用; 不填则用 DEMO_KEY, 只有 10 次)
DATA_GOV_API_KEY=
GOVINFO_API_KEY=
FTC_API_KEY=

# --- 免费, 需要账号
# sam.gov → Account Details → Public API Key
SAM_API_KEY=
# courtlistener.com → Profile → API
COURTLISTENER_TOKEN=
# https://data.uspto.gov/apikey (需 USPTO.gov 账号 + MFA + ID.me, 并补全个人资料)
USPTO_API_KEY=
# account.uspto.gov/api-manager
USPTO_TSDR_API_KEY=

# 劳工部开放数据 (OSHA), 免费: https://dataportal.dol.gov/registration
DOL_API_KEY=
# Alpha Vantage (财报电话会文字稿), 免费 25 次/天: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# UCC (科罗拉多/康涅狄格开放数据), 可选, 有了限流更宽松: https://dev.socrata.com/docs/app-tokens.html
SOCRATA_APP_TOKEN=

# --- 商业付费
DNB_API_KEY=
DNB_API_SECRET=
ORBIS_API_TOKEN=
ORBIS_BASE_URL=https://api.bvdinfo.com/v1/orbis
QUARTR_API_KEY=
LEXIS_CLIENT_ID=
LEXIS_CLIENT_SECRET=
LEXIS_BASE_URL=https://services-api.lexisnexis.com/v1
LEXIS_ENTITY=News
